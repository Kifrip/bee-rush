{
  "name": "bee-rush",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run build && npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/rules.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/e2e/*.spec.js",
    "test:headed": "BROWSER_TEST_HEADED=1 npm run test:browser"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "wrangler": "4.159.0",
    "@playwright/test": "1.65.0"
  }
}
